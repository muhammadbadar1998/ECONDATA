@page "/"
@inject HttpClient Http

<PageTitle>Overview</PageTitle>

<h1>EconData Overview</h1>

@if (_stats is null)
{
    <p class="empty-state">Loading overview...</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var tile in _tiles)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@tile.Label</h5>
                        <p class="stat-value">@tile.Value</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <h2 class="mt-4">Latest pipeline run</h2>
    @if (_stats.LastRunStatus is null)
    {
        <p class="empty-state">No pipeline runs recorded yet.</p>
    }
    else
    {
        <p>
            <span class="badge @RunBadge(_stats.LastRunStatus)">@_stats.LastRunStatus</span>
            <span class="ms-2">@_stats.LastRunTimestamp</span>
        </p>
    }
}

@code {
    private OverviewStats? _stats;
    private List<Tile> _tiles = new();

    protected override async Task OnInitializedAsync()
    {
        _stats = await Http.GetFromJsonAsync<OverviewStats>("api/overview");

        if (_stats is not null)
        {
            _tiles = new List<Tile>
            {
                new Tile("Entities", _stats.EntityCount.ToString("N0")),
                new Tile("Aliases", _stats.AliasCount.ToString("N0")),
                new Tile("Metrics", _stats.MetricCount.ToString("N0")),
                new Tile("Sources", _stats.SourceCount.ToString("N0")),
                new Tile("Observations", _stats.ObservationCount.ToString("N0")),
                new Tile("Embeddings", _stats.EmbeddingCount.ToString("N0")),
                new Tile("Memberships", _stats.MembershipCount.ToString("N0")),
            };
        }
    }

    private static string RunBadge(string? status) => status?.ToUpperInvariant() switch
    {
        "SUCCESS" => "bg-success",
        "FAILED" => "bg-danger",
        "RUNNING" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private sealed record Tile(string Label, string Value);
}
