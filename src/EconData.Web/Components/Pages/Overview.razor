@page "/"
@rendermode InteractiveServer
@inject HttpClient Http

@using System.Text.Json
@using EconData.Web.Services

<PageTitle>Overview</PageTitle>

<h1>EconData Overview</h1>

@if (_stats is null)
{
    <p class="empty-state">Loading overview...</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var tile in _tiles)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@tile.Label</h5>
                        <p class="stat-value">@tile.Value</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <h2 class="mt-4">Lake</h2>
    @if (_lake is null)
    {
        <p class="empty-state">Loading lake status...</p>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="d-flex gap-3 flex-wrap align-items-center">
                    @foreach (var tier in new[] { _lake.Bronze, _lake.Silver, _lake.Gold })
                    {
                        <span class="badge @(tier.Present ? "bg-success" : "bg-secondary")" data-tier="@tier.Tier">
                            @tier.Tier: @(tier.Present ? $"{tier.Rows:N0} rows" : "not built")
                        </span>
                    }
                </div>
                <p class="mt-2 mb-0 text-muted">
                    Newest: @(_lake.Gold.Newest ?? _lake.Silver.Newest ?? _lake.Bronze.Newest ?? "-")
                    &middot; <a href="lake">Open Lake page</a>
                </p>
            </div>
        </div>
    }

    <div class="card bg-light mb-3">
        <div class="card-header">Freshness</div>
        <div class="card-body">
<p class="card-text">
                @if (_freshness is not null && _freshness.Count > 0)
                {
                    @: <strong>Stale metrics (lag > 2 years):</strong> @( _freshness.Count(f => f.LagYears > 2 || f.LagYears is null) )
                    @: | <strong>Newest period:</strong> @(_freshness.Max(f => f.LatestPeriod) ?? "none")
                }
                else
                {
                    <em>No freshness data available</em>
                }
            </p>
        </div>
    </div>

    <h2 class="mt-4">Latest pipeline run</h2>
    @if (_stats.LastRunStatus is null)
    {
        <p class="empty-state">No pipeline runs recorded yet.</p>
    }
    else
    {
        <p>
            <span class="badge @RunBadge(_stats.LastRunStatus)">@_stats.LastRunStatus</span>
            <span class="ms-2">@_stats.LastRunTimestamp</span>
        </p>
    }
}

@code {
    private OverviewStats? _stats;
    private LakeStatus? _lake;
    private List<Tile> _tiles = new();
    private IReadOnlyList<FreshnessDto>? _freshness;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _stats is not null)
        {
            return;
        }

        _stats = await Http.GetFromJsonAsync<OverviewStats>("api/overview");
        _lake = await Http.GetFromJsonAsync<LakeStatus>("api/lake/status");

        if (_stats is not null)
        {
            _tiles = new List<Tile>
            {
                new Tile("Entities", _stats.EntityCount.ToString("N0")),
                new Tile("Aliases", _stats.AliasCount.ToString("N0")),
                new Tile("Metrics", _stats.MetricCount.ToString("N0")),
                new Tile("Sources", _stats.SourceCount.ToString("N0")),
                new Tile("Observations", _stats.ObservationCount.ToString("N0")),
                new Tile("Embeddings", _stats.EmbeddingCount.ToString("N0")),
                new Tile("Memberships", _stats.MembershipCount.ToString("N0")),
            };
        }

        // Freshness is supplementary: a failure here must not break the overview.
        try
        {
            _freshness = await Http.GetFromJsonAsync<IReadOnlyList<FreshnessDto>>("api/analytics/freshness");
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException)
        {
            _freshness = null;
        }
    }

    private static string RunBadge(string? status) => status?.ToUpperInvariant() switch
    {
        "SUCCESS" => "bg-success",
        "FAILED" => "bg-danger",
        "RUNNING" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private sealed record Tile(string Label, string Value);
}
