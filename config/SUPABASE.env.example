# Supabase PostgreSQL .env template (config/SUPABASE.env.example)
#
# Copy to config/.env and fill in real values. config/.env is gitignored.
# NEVER commit a real password. Rotate the password immediately if it is leaked.
#
# DB must remain private: only the owner's roles/IPs should reach it.
# Disable the anon/public PostgREST role and restrict by IP allowlist.

SUPABASE_HOST=db.your-project-ref.supabase.co
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SUPABASE_PORT=5432
