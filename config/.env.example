# Environment variables template for EconData pipeline.
#
# Copy this file to config/.env and fill in real values. config/.env is gitignored.
# NEVER commit real credentials. This platform is PostgreSQL/Supabase only.
#
# Load via python-dotenv (pip install python-dotenv).

# --- Database (Supabase PostgreSQL only) ---
SUPABASE_HOST=db.your-project-ref.supabase.co
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SUPABASE_PORT=5432

# Prefer the Supabase Session pooler on IPv4-only networks: the direct
# db.<project-ref>.supabase.co host is IPv6-only. If ECONDATA_DATABASE_URL (or
# DATABASE_URL / SHAREDPOOLER) is set, it overrides the SUPABASE_* fields above.
# Get the value from the Supabase dashboard: Connect -> Session pooler.
# ECONDATA_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# --- Embedding runtime (Ollama) ---
# Run `ollama serve` locally, then `ollama pull nomic-embed-text`.
# The pipeline calls Ollama's REST HTTP API; no Python package required.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=60
# Batch size of documents sent to Ollama per API call.
OLLAMA_EMBEDDING_BATCH_SIZE=32

# --- Chat / RAG runtime (python -m src.chat) ---
# Any OpenAI-compatible endpoint works (Ollama, vLLM, LM Studio, OpenAI, Groq, ...);
# only LLM_BASE_URL and LLM_MODEL need to change. For a local Ollama server the
# prerequisite is `ollama pull <chat-model>` (e.g. `ollama pull qwen2.5:7b-instruct`).
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Leave empty for local servers (the Authorization header is then omitted);
# set it for cloud endpoints. Never commit a real key.
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct
# Seconds allowed for one chat completion (distinct from OLLAMA_TIMEOUT above,
# which bounds fast embedding calls).
LLM_TIMEOUT=120
# Low temperature keeps the answers factual and grounded in the context.
LLM_TEMPERATURE=0.2
# Documents retrieved per question (context size / cost).
RAG_TOP_K=8
# Trailing observations embedded into each entity_metric document.
# Changing this requires a re-embed: python -m src.main --vectorize
RAG_RECENT_POINTS=5

# --- Pipeline paths (optional overrides) ---
# OUTPUT_DIR=./output
# CONFIG_PATH=./config/metrics.json
