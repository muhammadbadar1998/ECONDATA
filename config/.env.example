# Environment variables template for EconData pipeline.
#
# Copy this file to config/.env and fill in real values. config/.env is gitignored.
# NEVER commit real credentials. This platform is PostgreSQL/Supabase only.
#
# Load via python-dotenv (pip install python-dotenv).

# --- Database (Supabase PostgreSQL only) ---
SUPABASE_HOST=db.your-project-ref.supabase.co
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SUPABASE_PORT=5432

# Prefer the Supabase Session pooler on IPv4-only networks: the direct
# db.<project-ref>.supabase.co host is IPv6-only. If DATABASE_URL (or
# SHAREDPOOLER) is set, it overrides the SUPABASE_* fields above.
# Get the value from the Supabase dashboard: Connect -> Session pooler.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# SHAREDPOOLER=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# --- Pipeline paths (optional overrides) ---
# OUTPUT_DIR=./output
# CONFIG_PATH=./config/metrics.json
