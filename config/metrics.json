{
  "pipeline_settings": {
    "default_start_year": 1960,
    "default_end_year": 2060,
    "include_forecasts": true,
    "db_batch_size": 100
  },
  "metrics": [
    {
      "metric_code": "gdp_usd",
      "metric_name": "Gross Domestic Product (Current USD)",
      "category": "historical",
      "provider": "WB",
      "dataset": "WDI",
      "indicator_code": "NY.GDP.MKTP.CD",
      "unit": "Current US$",
      "base_unit": "Current US$",
      "frequency": "Annual",
      "dimension_key": "country",
      "entity_scope": "country",
      "synonyms": ["GDP", "gross domestic product", "economic output", "GDP current USD"],
      "description": "GDP at purchaser's prices is the sum of gross value added by all resident producers in the economy plus any product taxes and minus any subsidies not included in the value of the products.",
      "start_year": 1960,
      "end_year": 2026,
      "aggregation": "sum"
    },
    {
      "metric_code": "gdp_growth",
      "metric_name": "GDP Growth Rate (Annual %)",
      "category": "historical",
      "provider": "WB",
      "dataset": "WDI",
      "indicator_code": "NY.GDP.MKTP.KD.ZG",
      "unit": "%",
      "base_unit": "%",
      "frequency": "Annual",
      "dimension_key": "country",
      "entity_scope": "country",
      "synonyms": ["GDP growth", "economic growth", "real GDP growth"],
      "description": "Annual percentage growth rate of GDP at market prices based on constant local currency.",
      "start_year": 1960,
      "end_year": 2026,
      "aggregation": "mean"
    },
    {
      "metric_code": "inflation_cpi",
      "metric_name": "Inflation Rate, Consumer Prices (Annual %)",
      "category": "historical",
      "provider": "WB",
      "dataset": "WDI",
      "indicator_code": "FP.CPI.TOTL.ZG",
      "unit": "%",
      "base_unit": "%",
      "frequency": "Annual",
      "dimension_key": "country",
      "entity_scope": "country",
      "synonyms": ["inflation", "CPI", "consumer price index", "inflation rate"],
      "description": "Inflation as measured by the consumer price index reflects the annual percentage change in the cost to the average consumer of acquiring a basket of goods and services.",
      "start_year": 1960,
      "end_year": 2026,
      "aggregation": "mean"
    },
    {
      "metric_code": "unemployment_rate",
      "metric_name": "Unemployment Rate (% of Total Labor Force)",
      "category": "historical",
      "provider": "WB",
      "dataset": "WDI",
      "indicator_code": "SL.UEM.TOTL.ZS",
      "unit": "%",
      "base_unit": "%",
      "frequency": "Annual",
      "dimension_key": "country",
      "entity_scope": "country",
      "synonyms": ["unemployment", "jobless rate", "unemployment rate"],
      "description": "Unemployment refers to the share of the labor force that is without work but available for and seeking employment.",
      "start_year": 1960,
      "end_year": 2026,
      "aggregation": "mean"
    },
    {
      "metric_code": "population",
      "metric_name": "Total Population",
      "category": "historical",
      "provider": "WB",
      "dataset": "WDI",
      "indicator_code": "SP.POP.TOTL",
      "unit": "Persons",
      "base_unit": "Persons",
      "frequency": "Annual",
      "dimension_key": "country",
      "entity_scope": "country",
      "synonyms": ["population", "total population", "headcount"],
      "description": "Total population counts all residents regardless of legal status or citizenship.",
      "start_year": 1960,
      "end_year": 2026,
      "aggregation": "sum"
    },
    {
      "metric_code": "current_account_balance",
      "metric_name": "Current Account Balance (% of GDP)",
      "category": "historical",
      "provider": "WB",
      "dataset": "WDI",
      "indicator_code": "BN.CAB.XOKA.GD.ZS",
      "unit": "% of GDP",
      "base_unit": "% of GDP",
      "frequency": "Annual",
      "dimension_key": "country",
      "entity_scope": "country",
      "synonyms": ["current account", "current account balance", "CA balance"],
      "description": "Current account balance is the sum of net exports of goods and services, net primary income, and net secondary income relative to GDP.",
      "start_year": 1960,
      "end_year": 2026
    },
    {
      "metric_code": "govt_debt_gdp",
      "metric_name": "Central Government Debt (% of GDP)",
      "category": "historical",
      "provider": "WB",
      "dataset": "WDI",
      "indicator_code": "GC.DOD.TOTL.GD.ZS",
      "unit": "% of GDP",
      "base_unit": "% of GDP",
      "frequency": "Annual",
      "dimension_key": "country",
      "entity_scope": "country",
      "synonyms": ["government debt", "public debt", "debt to GDP"],
      "description": "Debt is the entire stock of direct government fixed-term contractual obligations to others outstanding on a particular date.",
      "start_year": 1960,
      "end_year": 2026
    },
    {
      "metric_code": "forecast_gdp_growth_gep",
      "metric_name": "Global Economic Prospects Real GDP Growth Forecast (Annual %)",
      "category": "forecast",
      "provider": "WB",
      "dataset": "GEP",
      "indicator_code": "NYGDPMKTPKDZ",
      "unit": "%",
      "base_unit": "%",
      "frequency": "Annual",
      "dimension_key": "country",
      "entity_scope": "country",
      "synonyms": ["GEP forecast", "GDP growth forecast"],
      "description": "Medium-term annual real GDP growth rate forecast from World Bank Global Economic Prospects.",
      "start_year": 2024,
      "end_year": 2030
    },
    {
      "metric_code": "forecast_gdp_longterm_oecd",
      "metric_name": "OECD Real GDP Long-Term Forecast (2024-2060)",
      "category": "forecast",
      "provider": "OECD",
      "dataset": "DP_LIVE",
      "indicator_code": "GDPLTFORECAST",
      "unit": "USD Millions (2015 PPP)",
      "base_unit": "USD",
      "unit_normalization": "x*1000000",
      "frequency": "Annual",
      "dimension_key": "LOCATION",
      "entity_scope": "country",
      "synonyms": ["OECD long-term forecast", "long-term GDP forecast"],
      "description": "Long-term projections of real GDP from OECD up to 2060.",
      "start_year": 2024,
      "end_year": 2060
    }
  ]
}
