      "metric_code": "gdp_usd",
      "metric_name": "Gross Domestic Product (Current USD)",
      "category": "historical",
      "provider": "WB",
      "dataset": "WDI",
      "indicator_code": "NY.GDP.MKTP.CD",
      "unit": "Current US$",
      "base_unit": "Current US$",
      "frequency": "Annual",
      "dimension_key": "country",
      "entity_scope": "country",
      "synonyms": [
        "GDP",
        "gross domestic product",
        "economic output",
        "GDP current USD"
      ],
